# Copy to `.env` and fill in. docker compose reads this file automatically.
#
# Vars marked [Vercel] are the ones to paste into Vercel's Project Settings →
# Environment Variables when deploying. Everything else only matters for local
# Docker dev. See "Deploying to Vercel + Supabase" in README.md for the full
# walkthrough.

# --- App -------------------------------------------------------------------

# [Vercel] Single Postgres connection string — the only thing that changes
# between targets. Local Docker: leave this as-is; it's only read by HOST-side
# tools (drizzle-kit, psql) since the `web` container builds its own from the
# POSTGRES_* vars below and talks to `db:5432` directly. On Vercel, this exact
# var is what the deployed app connects with — paste in your Supabase
# connection string. Prefer Supabase's pooled "Transaction" connection string
# (port 6543) over the direct one: Vercel's serverless functions can open many
# short-lived connections at once, and the pooler (Supavisor) is built for
# that, while the direct connection has a much lower limit and exhausts fast
# under concurrent requests.
DATABASE_URL=postgres://tracker:tracker@localhost:5433/tracker

# [Vercel] Whether to connect over SSL. Auto-detected from DATABASE_URL's
# hostname when unset: `localhost` / `127.0.0.1` / `db` (Docker) get no SSL,
# anything else — Supabase included — gets SSL with certificate-chain
# verification relaxed (encrypted, just not chain-verified — the standard
# trade-off for managed Postgres providers). Only set this if that guess is
# ever wrong for your host.
# DATABASE_SSL=true

# [Vercel] The single password you type on the login page.
APP_PASSWORD=change-me

# [Vercel] Signs the session cookie. Use something long and random, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# [Vercel] IANA timezone that decides what "today" means for every date-keyed
# log. e.g. Asia/Kolkata, Europe/London, America/New_York
APP_TIMEZONE=Asia/Kolkata

# [Vercel] Set to `true` on Vercel — it always serves over HTTPS, so the
# session cookie should get the `Secure` flag there. Left `false` here for
# local Docker dev, since you'll open this over plain http:// on your LAN from
# your phone, and a Secure cookie would never be sent over http://.
COOKIE_SECURE=false

# --- Postgres (the `db` service — Docker-only, not used on Vercel) --------
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker

# Host port the container's Postgres is published on. Defaults to 5433 rather
# than 5432 to avoid colliding with a natively-installed PostgreSQL — if both
# listen on 5432, host-side tools connect to the wrong server and fail with a
# confusing auth error.
DB_PORT=5433

# --- Backups (the `backup` service — Docker-only, not used on Vercel) -----
# Local hour (0-23, in APP_TIMEZONE) the daily pg_dump runs at.
BACKUP_HOUR=2

# Optional cloud sync — leave unset to skip it entirely. See backups/README.md;
# this needs a one-time interactive `rclone config` you run yourself.
RCLONE_REMOTE=
