# Copy to `.env` and fill in. docker compose reads this file automatically.

# --- Postgres (the `db` service) -----------------------------------------
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker

# Host port the container's Postgres is published on. Defaults to 5433 rather
# than 5432 to avoid colliding with a natively-installed PostgreSQL — if both
# listen on 5432, host-side tools connect to the wrong server and fail with a
# confusing auth error.
DB_PORT=5433

# --- App -----------------------------------------------------------------
# Only used by scripts you run from the HOST (drizzle-kit studio, psql, etc.),
# so it points at the published port on localhost. The web container builds its
# own DATABASE_URL from the POSTGRES_* vars above and talks to `db:5432`.
DATABASE_URL=postgres://tracker:tracker@localhost:5433/tracker

# The single password you type on the login page.
APP_PASSWORD=change-me

# Signs the session cookie. Use something long and random, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# IANA timezone that decides what "today" means for every date-keyed log.
# e.g. Asia/Kolkata, Europe/London, America/New_York
APP_TIMEZONE=Asia/Kolkata

# Set to `true` only if you serve the app over HTTPS. Left false so the session
# cookie still works over plain http:// on your LAN (e.g. from your phone).
COOKIE_SECURE=false

# --- Backups (the `backup` service) ---------------------------------------
# Local hour (0-23, in APP_TIMEZONE) the daily pg_dump runs at.
BACKUP_HOUR=2

# Optional cloud sync — leave unset to skip it entirely. See backups/README.md;
# this needs a one-time interactive `rclone config` you run yourself.
RCLONE_REMOTE=
