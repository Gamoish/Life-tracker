DATABASE_URL=postgresql://postgres.frikjkhqaolbbyxmiwzg:Z7E7a6CyVs7ENWpXoCxLauM9wApiYWbt@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# CHANGE THIS before you put the app on your phone / local network.
APP_PASSWORD=htJnhViGQxKf8WMARy4f

SESSION_SECRET=ab39264127732c2af95a4664407d36297628a02931ffb70d6aa8268e2a29db65

# Set to `true` only if you serve the app over HTTPS. Left false so the session
# cookie still works over plain http:// on your LAN (e.g. from your phone).
COOKIE_SECURE=false

# Decides what "today" means for every habit, health and DSA log.
APP_TIMEZONE=Asia/Kolkata

# --- Backups (the `backup` service) ---------------------------------------
# Local hour (0-23, Asia/Kolkata) the daily pg_dump runs at.
BACKUP_HOUR=2

# Optional cloud sync — unset. See backups/README.md before turning this on.
RCLONE_REMOTE=
