# Local config — gitignored. Generated from .env.example.

# --- Postgres (the `db` service) -----------------------------------------
POSTGRES_USER=tracker
POSTGRES_PASSWORD=6nnCBavM0iE3CCjv
POSTGRES_DB=tracker

# Host port for the container's Postgres. Not 5432 — a native PostgreSQL 18
