", "source_location": "README.md:142-145", "weight": 1.0}, {"source": "readme_idempotent_roadmap_seed", "target": "scripts_seed_roadmaps_seedroadmap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:115-140", "weight": 1.0}, {"source": "readme_idempotent_roadmap_seed", "target": "package_scripts_seed_roadmaps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:61-63", "weight": 1.0}, {"source": "readme_idempotent_roadmap_seed", "target": "src_db_schema_roadmaptopics", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "README.md:142-145", "weight": 1.0}, {"source": "readme_roadmap_delete_set_null", "target": "src_db_schema_goals", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:220-221", "weight": 1.0}, {"source": "readme_roadmap_delete_set_null", "target": "src_lib_goal_progress_computegoalprogress", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "README.md:220-221", "weight": 1.0}, {"source": "readme_habits_no_bottom_nav", "target": "src_components_bottomnav", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:235-237", "weight": 1.0}, {"source": "readme_habits_no_bottom_nav", "target": "src_app_app_habits_habitchecklist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "README.md:236-237", "weight": 1.0}, {"source": "readme_phase1_scope", "target": "readme_tracker", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.m