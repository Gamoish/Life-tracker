{"nodes": [{"id": "docker_compose_db", "label": "db service (postgres:17-alpine)", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:2-17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Postgres 17 with a pg_isready healthcheck (5s interval, 10 retries); publishes ${DB_PORT:-5433}:5432 and persists to the pgdata volume."}, {"id": "docker_compose_web", "label": "web service (Next.js app container)", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:19-34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built from the local Dockerfile, publishes 3000:3000, and receives DATABASE_URL, APP_PASSWORD, SESSION_SECRET, APP_TIMEZONE and COOKIE_SECURE from the environment."}, {"id": "docker_compose_pgdata", "label": "pgdata volume", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:36-37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named volume holding /var/lib/postgresql/data, so `docker compose down` keeps the data and only `down -v` wipes it."}, {"id": "docker_compose_healthcheck_gate", "label": "web waits on db service_healthy", "file_type": "rationale", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:23-25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "depends_on with condition: service_healthy means Postgres comes up and passes pg_isready before web starts, so the app never boots against a database that is not accepting connections yet."}, {"id": "docker_compose_database_url", "label": "DATABASE_URL uses the compose service name", "file_type": "rationale", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:27-28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inside the compose network the database host is the service name `db` on port 5432 \u2014 distinct from the host-side localhost:5433 that .env uses for scripts run outside the container."}, {"id": "docker_compose_required_secrets", "label": "APP_PASSWORD and SESSION_SECRET are required at startup", "file_type": "rationale", "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:29-30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both use the ${VAR:?message} form, so compose refuses to start the stack with a clear error rather than booting an app with an empty password or an unsigned session."}], "edges": [{"source": "docker_compose_web", "target": "docker_compose_db", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:23-28", "weight": 1.0}, {"source": "docker_compose_healthcheck_gate", "target": "docker_compose_web", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:23-25", "weight": 1.0}, {"source": "docker_compose_healthcheck_gate", "target": "docker_compose_db", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:13-17", "weight": 1.0}, {"source": "docker_compose_db", "target": "docker_compose_pgdata", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:11-12", "weight": 1.0}, {"source": "docker_compose_database_url", "target": "src_db_index", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docker-compose.yml", "source_location": "docker-compose.yml:27-28", "weight": 1.0}, {"source": "docker_compose_database_url